    // Regression guard for the f32281502 `??=` freeze: once OnParametersSet seeded
    // GraphicsLayerId/LayerId it never re-synced them to the bound GraphicsLayer, so a layer
    // reference that changed after the first render (e.g. an @ref instance replacing an earlier
    // value) left the widget serializing a stale id -> arcGisObjectRefs lookup miss -> disabled
    // toolbar. This asserts the C# invariant the fix restores: the serialized ids always track the
    // live GraphicsLayer instance. (The end-to-end "tools enabled" behavior with the `= new()` +
    // @ref double-instance anti-pattern is covered by running the sample; the supported authoring
    // pattern is a nullable @ref field with no `= new()`, as in TestCanSetLayerByGraphicsLayerProperty.)
    [TestMethod]
    public async Task TestGraphicsLayerIdTracksLiveLayerInstance(Action renderHandler)
    {
        GraphicsLayer? layer = null;
        SketchWidget? widget = null;

        AddMapRenderFragment(@<MapView class="map-view" OnViewRendered="renderHandler">
                                 <Map>
                                     <Basemap>
                                         <BasemapStyle Name="BasemapStyleName.ArcgisNavigation" />
                                     </Basemap>
                                     <GraphicsLayer @ref="layer" Title="Test layer" />
                                 </Map>
                                 <SketchWidget @ref="widget"
                                               Position="OverlayPosition.TopRight"
                                               GraphicsLayer="layer" />
                             </MapView>);

        await WaitForMapToRender();
        Assert.IsNotNull(widget!.GraphicsLayer);
        // The serialized ids must equal the live layer instance's id, not a stale frozen value.
        Assert.AreEqual(widget.GraphicsLayer!.Id, widget.GraphicsLayerId);
        Assert.AreEqual(widget.GraphicsLayer!.Id, widget.LayerId);
    }

    [TestMethod]
    public async Task TestCanSetLayerByLayerIdProperty(Action renderHandler)
    {
        MapView? mapView = null;
        GraphicsLayer layer = new(title: "Test layer");
        SketchWidget? widget = null;

        AddMapRenderFragment(@<MapView @ref="mapView" class="map-view" OnViewRendered="renderHandler">
                                 <Map>
                                     <Basemap>
                                         <BasemapStyle Name="BasemapStyleName.ArcgisNavigation" />
                                     </Basemap>
                                 </Map>
                                 <SketchWidget @ref="widget"
                                               Position="OverlayPosition.TopRight"
                                               LayerId="layer.Id" />
                             </MapView>);

        await WaitForMapToRender();
        await mapView!.AddLayer(layer);
        // AddLayer resolves the widget's layer on a later render cycle, not synchronously; pump renders until it lands.
        for (int tries = 50; widget!.Layer is null && tries > 0; tries--)
        {
            await Task.Delay(100);
            await InvokeAsync(StateHasChanged);
        }
        Assert.IsNotNull(widget!.Layer);
        Assert.AreEqual(widget.Layer.Id, layer.Id);
        await AssertJavaScript("assertObjectHasPropertyWithValue", args: [widget!.Id, "layer.title", "Test layer"]);
    }

