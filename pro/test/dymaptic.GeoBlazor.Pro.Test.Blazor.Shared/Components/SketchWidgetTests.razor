    [TestMethod]
    public async Task TestCanSetAvailableCreateTools(System.Action renderHandler)
    {
        GraphicsLayer layer = new();
        SketchWidget? widget = null;

        AddMapRenderFragment(@<MapView class="map-view" OnViewRendered="renderHandler">
                                 <Map>
                                     <Basemap>
                                         <BasemapStyle Name="BasemapStyleName.ArcgisNavigation" />
                                     </Basemap>
                                     <GraphicsLayer @ref="layer" />
                                 </Map>
                                 <SketchWidget @ref="widget"
                                               Position="OverlayPosition.TopRight"
                                               GraphicsLayerId="layer.Id"
                                               AvailableCreateTools="@([AvailableCreateTool.Polyline])" />
                             </MapView>);

        await WaitForMapToRender();
        await AssertProJavaScript("sketchWidgetAsserts.assertTools", args: [widget!.Id, new List<string> { "polyline" }]);
    }

