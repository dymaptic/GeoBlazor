    [TestMethod]
    public async Task TestCanSetLayerOnSnappingOptionsAtRuntime(Action renderHandler)
    {
        GraphicsLayer? sketchLayer = null;
        GraphicsLayer? snapLayer = null;
        SnappingOptions? snappingOptions = null;
        SketchWidget? widget = null;

        AddMapRenderFragment(@<MapView class="map-view" OnViewRendered="renderHandler">
                                 <Map>
                                     <Basemap>
                                         <BasemapStyle Name="BasemapStyleName.ArcgisNavigation" />
                                     </Basemap>
                                     <GraphicsLayer @ref="sketchLayer" Title="Sketch layer" />
                                     <GraphicsLayer @ref="snapLayer" Title="Snap layer" />
                                 </Map>
                                 <SketchWidget @ref="widget"
                                               Position="OverlayPosition.TopRight"
                                               GraphicsLayer="sketchLayer">
                                     <SnappingOptions @ref="snappingOptions"
                                                      Enabled="true"
                                                      FeatureEnabled="true" />
                                 </SketchWidget>
                             </MapView>);

        await WaitForMapToRender();

        await snappingOptions!.SetLayer(snapLayer);

        await AssertJavaScript("assertObjectHasArcGisLayer",
            args: [snappingOptions.Id, "layer", snapLayer!.ArcGISLayerId]);
        await AssertProJavaScript("sketchWidgetAsserts.assertSketchLayer", args: [widget!.Id, sketchLayer!.Id]);
    }

