    // Reproduces a question from a customer: when entering edit mode, they want to
    // programmatically set FeatureSnappingLayerSources on a declaratively-built
    // SnappingOptions, pointing each source at the layer being edited.
    // FeatureSnappingLayerSource currently exposes neither a `Layer` constructor
    // parameter nor a settable `Layer` property, so this scenario is not
    // expressible from C#. This test encodes the desired API; it will fail to
    // compile until the wrapper is generated with Layer support.
    [TestMethod]
    public async Task TestCanSetFeatureSnappingLayerSourceAtRuntime(Action renderHandler)
    {
        GraphicsLayer sketchLayer = new();
        FeatureLayer snapTargetLayer = new();
        SketchWidget? widget = null;

        AddMapRenderFragment(@<MapView class="map-view" OnViewRendered="renderHandler">
                                 <Map>
                                     <Basemap>
                                         <BasemapStyle Name="BasemapStyleName.ArcgisNavigation" />
                                     </Basemap>
                                     <GraphicsLayer @ref="sketchLayer" />
                                     <FeatureLayer @ref="snapTargetLayer"
                                                   Url="https://services.arcgis.com/V6ZHFr6zdgNZuVG0/arcgis/rest/services/Landscape_Trees/FeatureServer/0" />
                                 </Map>
                                 <SketchWidget @ref="widget"
                                               Position="OverlayPosition.TopRight"
                                               GraphicsLayerId="sketchLayer.Id">
                                     <SnappingOptions Enabled="true"
                                                      FeatureEnabled="true" />
                                 </SketchWidget>
                             </MapView>);

        await WaitForMapToRender();

        await widget!.SetSnappingOptions(new SnappingOptions(enabled: true,
            featureEnabled: true,
            featureSources: new List<FeatureSnappingLayerSource>
            {
                new(enabled: true, layer: snapTargetLayer)
            }));

        await AssertJavaScript("assertObjectHasPropertyWithValue",
            args:
            [
                widget!.Id, "snappingOptions.featureSources[0].layer.id",
                snapTargetLayer.ArcGISLayerId
            ]);
    }

