    [TestMethod]
    public async Task TestCanGetColumns(System.Action renderHandler)
    {
        FeatureTableWidget? widget = null;
        FeatureLayer? layer = null;
        AddMapRenderFragment(
            @<MapView class="map-view" OnViewRendered="renderHandler">
                <Map>
                    <Basemap>
                        <BasemapStyle Name="BasemapStyleName.ArcgisNavigation" />
                    </Basemap>
                    <FeatureLayer @ref="layer"
                                  Url="https://services.arcgis.com/V6ZHFr6zdgNZuVG0/arcgis/rest/services/US_National_Parks_Annual_Visitation/FeatureServer/0" />
                </Map>
                <FeatureTableWidget @ref="widget" 
                                    Layer="layer"
                                    Position="OverlayPosition.BottomRight" />
            </MapView>);

        await WaitForMapToRender(timeoutInSeconds: 30);

        // wait for the table to finish loading its data
        int tries = 100;
        IReadOnlyList<Column>? columns = null;

        while (tries > 0 && (columns is null || columns.Count == 0))
        {
            await Task.Delay(1000);
            columns = await widget!.GetColumns();
            tries--;
        }

        Assert.IsNotNull(columns);
        Assert.IsTrue(columns.Count > 0, "FeatureTable should have at least one column");
        await AssertJavaScript("isValidElementRef", args: [columns[0].Menu]);
    }

