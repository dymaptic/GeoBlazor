@code {

    [TestMethod]
    public async Task TestCanRenderFeatureTableWidget(System.Action renderHandler)
    {
        FeatureTableWidget? widget = null;
        FeatureLayer? layer = null;
        AddMapRenderFragment(
            @<MapView class="map-view" OnViewRendered="renderHandler">
                <Map>
                    <Basemap>
                        <BasemapStyle Name="BasemapStyleName.ArcgisNavigation" />
                    </Basemap>
                    <FeatureLayer @ref="layer"
                                  Url="https://services.arcgis.com/V6ZHFr6zdgNZuVG0/arcgis/rest/services/US_National_Parks_Annual_Visitation/FeatureServer/0" />
                </Map>
                <FeatureTableWidget @ref="widget" Layers="@(layer is null ? null : [layer])" />
            </MapView>);

        await WaitForMapToRender(timeoutInSeconds: 30);

        Assert.AreNotEqual(Guid.Empty, widget!.Id);
    }

    [TestMethod]
    public async Task TestSetsPropertiesOnJsWidget(System.Action renderHandler)
    {
        FeatureTableWidget? widget = null;
        FeatureLayer? layer = null;
        AddMapRenderFragment(
            @<MapView class="map-view" OnViewRendered="renderHandler">
                <Map>
                    <Basemap>
                        <BasemapStyle Name="BasemapStyleName.ArcgisNavigation" />
                    </Basemap>
                    <FeatureLayer @ref="layer"
                                  Url="https://services.arcgis.com/V6ZHFr6zdgNZuVG0/arcgis/rest/services/US_National_Parks_Annual_Visitation/FeatureServer/0" />
                </Map>
                <FeatureTableWidget @ref="widget"
                                    Layers="@(layer is null ? null : [layer])"
                                    MultipleSelectionDisabled="true"
                                    HighlightDisabled="true"
                                    EditingEnabled="true"
                                    PageSize="25"
                                    Label="Test Table" />
            </MapView>);

        await WaitForMapToRender(timeoutInSeconds: 30);

        await AssertJavaScript("assertObjectHasPropertyWithValue",
            args: [widget!.Id, "multipleSelectionDisabled", true]);
        await AssertJavaScript("assertObjectHasPropertyWithValue",
            args: [widget.Id, "highlightDisabled", true]);
        await AssertJavaScript("assertObjectHasPropertyWithValue",
            args: [widget.Id, "editingEnabled", true]);
        await AssertJavaScript("assertObjectHasPropertyWithValue",
            args: [widget.Id, "pageSize", 25]);
        await AssertJavaScript("assertObjectHasPropertyWithValue",
            args: [widget.Id, "label", "Test Table"]);
    }

