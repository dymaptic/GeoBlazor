    [TestMethod]
    public async Task TestMapImageLayerFetchImageWithCancellation(System.Action renderHandler, Action<LayerViewCreateEvent> layerViewCreated)
    {
        MapImageLayer? layer = null;
        MapView? mapView = null;

        AddMapRenderFragment(
            @<MapView @ref="mapView"
                class="map-view"
                OnViewRendered="renderHandler"
                OnLayerViewCreate="layerViewCreated">
                <Map>
                    <MapImageLayer @ref="layer"
                                   Url="https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer"/>
                </Map>
            </MapView>);

        await WaitForMapToRender();

        LayerViewCreateEvent createEvent = await WaitForLayerToRender<MapImageLayer>();
        Assert.IsInstanceOfType<MapImageLayer>(createEvent.Layer);
        MapImageLayer createdLayer = (MapImageLayer)createEvent.Layer;
        Assert.AreEqual(layer?.Id, createdLayer.Id);
        
        Extent? extent = await mapView!.GetExtent();
        Assert.IsNotNull(extent);

        // Test cancellation
        using var cts = new CancellationTokenSource();
        var options = new MapImageLayerFetchImageOptions();
        
        // Cancel before it starts
        await cts.CancelAsync();

        // Start the fetch operation
        Task<IJSObjectReference?> fetchTask = layer!.FetchImage(extent, 512, 512, options, cts.Token);

        await Assert.ThrowsAsync<OperationCanceledException>(async () => await fetchTask);
    }

    [TestMethod]
    public async Task TestMapImageLayerFetchImageWithDifferentSizes(System.Action renderHandler, Action<LayerViewCreateEvent> layerViewCreated)
    {
        MapImageLayer? layer = null;
        MapView? mapView = null;

        AddMapRenderFragment(
            @<MapView @ref="mapView"
                class="map-view"
                OnViewRendered="renderHandler"
                OnLayerViewCreate="layerViewCreated">
                <Map>
                    <MapImageLayer @ref="layer"
                                   Url="https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer"/>
                </Map>
            </MapView>);

        await WaitForMapToRender();

        var createEvent = await WaitForLayerToRender<MapImageLayer>();
        Assert.IsInstanceOfType<MapImageLayer>(createEvent.Layer);
        MapImageLayer createdLayer = (MapImageLayer)createEvent.Layer;
        Assert.AreEqual(layer?.Id, createdLayer.Id);

        var extent = await mapView!.GetExtent();
        Assert.IsNotNull(extent);

        var options = new MapImageLayerFetchImageOptions();

        // Test different image sizes
        var sizes = new[] { (128, 128), (256, 256), (512, 512), (1024, 1024) };

        foreach (var (width, height) in sizes)
        {
            var imageResult = await layer!.FetchImage(extent, width, height, options);
            Assert.IsNotNull(imageResult, $"Failed to fetch image with size {width}x{height}");
        }
    }

