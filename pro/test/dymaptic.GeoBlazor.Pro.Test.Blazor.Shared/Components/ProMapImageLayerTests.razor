    [TestMethod]
    public async Task TestMapImageLayerFetchImageErrorHandling(Func<Exception, Task<bool>> errorHandler)
    {
        AddMapRenderFragment(@<MapView class="map-view"
                                       OnExceptionHandler="errorHandler">
                <Map>
                    <MapImageLayer Url="@($"{NavigationManager.BaseUri}/MapServer")"/>
                </Map>
            </MapView>);

        string message = await WaitForDisplayedError();

        Assert.Contains("Failed to create layerview for layer", message);
