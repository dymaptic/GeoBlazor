    [TestMethod]
    public async Task TestWMSLayerLoadInMarkupAndFindSublayerById()
    {
        WMSLayer? layer = null;

        AddMapRenderFragment(@<WMSLayer @ref="layer" Url="https://ows.terrestris.de/osm/service"
                                        SpatialReference="new SpatialReference(102100)"/>);

        StateHasChanged();

        // we don't have a map to call the render handlers.
        await Task.Delay(200);

        await layer!.Load();

        IReadOnlyList<WMSSublayer>? sublayers = await layer.GetAllSublayers();
        Assert.IsNotNull(sublayers);

        if (sublayers.Any())
        {
            WMSSublayer firstSublayer = sublayers.First();
            WMSSublayer? foundSublayer = await layer.FindSublayerById(firstSublayer.WMSSublayerId! ?? -1);
            Assert.IsNotNull(foundSublayer);

            //The Ids don't seem to match. It might be because it is querying the layer on the server and getting back a new object?
            Assert.AreEqual(firstSublayer.Name, foundSublayer.Name);
        }
    }

