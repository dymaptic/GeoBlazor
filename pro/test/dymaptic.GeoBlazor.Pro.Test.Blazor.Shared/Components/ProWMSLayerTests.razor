@code {

    [TestMethod]
    public async Task TestCanRenderWMSLayerWithMultiLayers(System.Action renderHandler, Action<LayerViewCreateEvent> layerViewCreated)
    {
        WMSLayer? layer = null;

        // NOTE: This test used to just auto-load all sublayers. However, there is an error on this server for the "Dark" sublayer.
        // Hitting that error causes the test to fail.
        AddMapRenderFragment(@<SceneView
                                 class="map-view"
                                 OnViewRendered="renderHandler"
                                 OnLayerViewCreate="layerViewCreated">
                                 <Map>
                                     <WMSLayer @ref="layer" Url="https://ows.terrestris.de/osm/service"
                                               SpatialReference="new SpatialReference(102100)">
                                         <WMSSublayer Name="TOPO-WMS"/>
                                         <WMSSublayer Name="TOPO-OSM-WMS"/>
                                         <WMSSublayer Name="SRTM30-Colored-Hillshade"/>
                                     </WMSLayer>
                                 </Map>
                             </SceneView>);

        await WaitForMapToRender(timeoutInSeconds: 90);

        LayerViewCreateEvent createEvent = await WaitForLayerToRender<WMSLayer>();
        Assert.IsInstanceOfType<WMSLayer>(createEvent.Layer);
        WMSLayer? createdLayer = (WMSLayer)createEvent.Layer;
        Assert.AreEqual(layer?.Id, createdLayer.Id);

        await layer!.Load();
        WMSSublayer? subLayer = await layer.FindSublayerByName("TOPO-WMS");
        Assert.IsNotNull(subLayer);
        await layer.SetSublayers([subLayer!]);

        Assert.IsTrue(layer!.Sublayers!.Count == 1);

        //compares the layer.Type value
        await AssertJavaScript("assertLayerExists", args: "wms");
    }

    [TestMethod]
    public async Task TestWMSLayerFetchImageAsString(System.Action renderHandler, Action<LayerViewCreateEvent> layerViewCreated)
    {
        WMSLayer? layer = null;
        SceneView? sceneView = null;

        AddMapRenderFragment(@<div>
                                 <SceneView @ref="sceneView"
                                            class="map-view"
                                            OnViewRendered="renderHandler"
                                            OnLayerViewCreate="layerViewCreated">
                                     <Map>
                                         <WMSLayer @ref="layer" Url="https://ows.terrestris.de/osm/service"
                                                   SpatialReference="new SpatialReference(102100)">
                                             <WMSSublayer Name="TOPO-WMS"/>
                                         </WMSLayer>
                                     </Map>
                                 </SceneView>
                             </div>);

        await WaitForMapToRender(timeoutInSeconds: 90);

        LayerViewCreateEvent createEvent = await WaitForLayerToRender<WMSLayer>();
        Assert.IsInstanceOfType<WMSLayer>(createEvent.Layer);
        WMSLayer? createdLayer = (WMSLayer)createEvent.Layer;
        Assert.AreEqual(layer?.Id, createdLayer.Id);

        Extent? extent = await sceneView!.GetExtent();

