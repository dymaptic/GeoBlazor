    [TestMethod]
    public async Task TestWMSLayerSublayerManagement()
    {
        WMSLayer? layer = null;

        AddMapRenderFragment(@<WMSLayer @ref="layer" Url="https://ows.terrestris.de/osm/service"
                                        SpatialReference="new SpatialReference(102100)">
                                 <WMSSublayer Name="OSM-WMS-no-labels"/>
                                 <WMSSublayer Name="TOPO-WMS"/>
                             </WMSLayer>);
        
        StateHasChanged();

        // we don't have a map to call the render handlers.
        await Task.Delay(200);

        await layer!.Load();

        IReadOnlyList<WMSSublayer>? allSublayers = await layer.GetAllSublayers();
        Assert.IsNotNull(allSublayers);

        if (allSublayers.Any())
        {
            WMSSublayer firstSublayer = allSublayers.First();
            await layer.SetSublayers([firstSublayer]);

            IReadOnlyList<WMSSublayer>? currentSublayers = await layer.GetSublayers();
            Assert.IsNotNull(currentSublayers);
            Assert.AreEqual(1, currentSublayers.Count);
            Assert.AreEqual(firstSublayer.Id, currentSublayers.First().Id);
        }
    }

