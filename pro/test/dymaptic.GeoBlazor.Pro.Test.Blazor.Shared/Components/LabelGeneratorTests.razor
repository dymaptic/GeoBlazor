@inherits ProTestRunnerBase
@attribute [TestCategory(nameof(ProLogicComponent))]
@attribute [TestCategory(nameof(LogicComponent))]

@{
    base.BuildRenderTree(__builder);
}

@code {
    [Inject]
    public required LabelGenerator LabelGenerator { get; set; }

    [TestMethod]
    public async Task TestGetClusterLabelSchemes(Action renderHandler,
        Action<LayerViewCreateEvent> onLayerViewCreateHandler)
    {
        FeatureLayer? layer = null;

        AddMapRenderFragment(@<MapView Class="map-view"
                                       Center="@(new Point(80.20127, 22.12355))"
                                       Zoom="4"
                                       OnViewRendered="renderHandler"
                                       OnLayerViewCreate="onLayerViewCreateHandler">
                                 <Map>
                                     <Basemap>
                                         <BasemapStyle Name="BasemapStyleName.ArcgisTopographic"/>
                                     </Basemap>
                                     <FeatureLayer @ref="layer"
                                                   Url="https://services.arcgis.com/V6ZHFr6zdgNZuVG0/arcgis/rest/services/Places_of_Worship_India/FeatureServer/0"
                                                   Title="Places of worship"
                                                   OutFields="@(["name", "religion", "denomination"])">
                                     </FeatureLayer>
                                 </Map>
                             </MapView>);
        await WaitForMapToRender();
        await WaitForLayerToRender<FeatureLayer>();
        LabelSchemes schemes = await LabelGenerator.GetClusterLabelSchemes(layer!, layer!.ViewId!.Value);
        Assert.IsNotNull(schemes.PrimaryScheme);
        Assert.IsNotNull(schemes.PrimaryScheme.ClusterMinSize);
        Assert.IsGreaterThan(0, schemes.PrimaryScheme.LabelingInfo.Count);
    }

    [TestMethod]
    public async Task TestGetClusterLabelSchemesWithField(Action renderHandler,
        Action<LayerViewCreateEvent> onLayerViewCreateHandler)
    {
        GeoJSONLayer? layer = null;

        AddMapRenderFragment(@<MapView Class="map-view"
                                       ExcludeApiKey="true" Scale="288895"
                                       Center="@(new Point(-73.94226, 40.7163))"
                                       OnViewRendered="renderHandler"
                                       OnLayerViewCreate="onLayerViewCreateHandler">
                                 <SpatialReference Wkid="5936"/>
                                 <Extent Xmax="2461436" Xmin="1270382"
                                         Ymax="-953893" Ymin="-1729511">
                                     <SpatialReference Wkid="5936"/>
                                 </Extent>
                                 <Map>
                                     <GeoJSONLayer @ref="layer"
                                                   Title="Earthquakes from the last month"
                                                   Url="https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_month.geojson"
                                                   Copyright="USGS Earthquakes">
                                         <FeatureReductionCluster ClusterRadius="@("100px")"
                                                                  ClusterMinSize="@("24px")"
                                                                  ClusterMaxSize="@("60px")">
                                             <PopupTemplate Title="Cluster summary"
                                                            StringContent="This cluster represents {cluster_count} earthquakes.">
                                                 <FieldInfo FieldName="cluster_count">
                                                     <FieldInfoFormat Places="0" DigitSeparator="true"/>
                                                 </FieldInfo>
                                             </PopupTemplate>
                                             <SimpleMarkerSymbol Style="@SimpleMarkerSymbolStyle.Circle"
                                                                 Color="@(new MapColor("#69dcff"))">
                                                 <Outline Color="@(new MapColor(0, 139, 174, 0.5))" Width="6"/>
                                             </SimpleMarkerSymbol>
                                             <Label DeconflictionStrategy="DeconflictionStrategy.None"
                                                    LabelPlacement="LabelPlacement.CenterCenter">
                                                 <LabelExpressionInfo
                                                     Expression="Text($feature.cluster_count, '#,###')"/>
                                                 <TextSymbol Color="@(new MapColor("#004a5d"))">
                                                     <MapFont Weight="FontWeight.Bold" Family="Noto Sans" Size="12"/>
                                                 </TextSymbol>
                                             </Label>
                                         </FeatureReductionCluster>
                                     </GeoJSONLayer>
                                 </Map>
                             </MapView>);
        await WaitForMapToRender();
        await WaitForLayerToRender<GeoJSONLayer>();
        LabelSchemes schemes = await LabelGenerator.GetClusterLabelSchemes(layer!, layer!.ViewId!.Value, "cluster_count");
        Assert.IsNotNull(schemes.PrimaryScheme);
        Assert.IsNotNull(schemes.PrimaryScheme.ClusterMinSize);
        Assert.IsGreaterThan(0, schemes.PrimaryScheme.LabelingInfo.Count);
    }

