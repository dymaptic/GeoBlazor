{
  "$schema": "https://json.schemastore.org/template",
  "author": "dymaptic",
  "classifications": [
    "Web",
    "Blazor",
    "WebAssembly",
    "Mapping",
    "Location",
    "Geographic",
    "Geospatial",
    "Geolocation",
    "Geographic Information System",
    "GIS"
  ],
  "name": "GeoBlazor Web App",
  "defaultName": "GeoBlazorWebApp",
  "description": "A project template for creating a Blazor web app with GeoBlazor that supports both server-side rendering and client interactivity. This template can be used for web apps with rich dynamic user interfaces (UIs) including interactive maps.",
  "groupIdentity": "GeoBlazor Web App",
  "precedence": "10000",
  "guids": [
    "68FF10DE-9D37-4437-A332-022203F995A9"
  ],
  "identity": "dymaptic.GeoBlazor.Templates.GeoBlazorWebApp.4.0.0",
  "preferNameDirectory": true,
  "primaryOutputs": [
    {
      "condition": "(UseWebAssembly && (HostIdentifier == \"dotnetcli\" || HostIdentifier == \"dotnetcli-preview\"))",
      "path": "GeoBlazorWebApp.sln"
    },
    {
      "condition": "(UseWebAssembly && HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "GeoBlazorWebApp/GeoBlazorWebApp.csproj"
    },
    {
      "condition": "(!UseWebAssembly)",
      "path": "GeoBlazorWebApp.csproj"
    },
    {
      "condition": "(UseWebAssembly && HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "GeoBlazorWebApp.Client/GeoBlazorWebApp.Client.csproj"
    }
  ],
  "shortName": "geoblazor",
  "sourceName": "GeoBlazorWebApp",
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**"
      ],
      "copyOnly": [
        "**/wwwroot/bootstrap/**"
      ],
      "modifiers": [
        {
          "condition": "(!UseWebAssembly)",
          "exclude": [
            "GeoBlazorWebApp.Client/**",
            "*.sln"
          ],
          "rename": {
            "GeoBlazorWebApp/": "./"
          }
        },
        {
          "condition": "(UseWebAssembly && InteractiveAtRoot)",
          "rename": {
            "GeoBlazorWebApp/Components/Layout/": "./GeoBlazorWebApp.Client/Layout/",
            "GeoBlazorWebApp/Components/Pages/Home.razor": "./GeoBlazorWebApp.Client/Pages/Home.razor",
            "GeoBlazorWebApp/Components/Pages/NotFound.razor": "./GeoBlazorWebApp.Client/Pages/NotFound.razor",
            "GeoBlazorWebApp/Components/Pages/Weather.razor": "./GeoBlazorWebApp.Client/Pages/Weather.razor",
            "GeoBlazorWebApp/Components/Routes.razor": "./GeoBlazorWebApp.Client/Routes.razor"
          }
        },
        {
          "condition": "(!UseProgramMain)",
          "exclude": [
            "GeoBlazorWebApp/Program.Main.cs",
            "GeoBlazorWebApp.Client/Program.Main.cs"
          ]
        },
        {
          "condition": "(UseProgramMain)",
          "exclude": [
            "GeoBlazorWebApp/Program.cs",
            "GeoBlazorWebApp.Client/Program.cs"
          ],
          "rename": {
            "Program.Main.cs": "Program.cs"
          }
        },
        {
          "condition": "(!(UseServer && !UseWebAssembly))",
          "exclude": [
            "GeoBlazorWebApp/Components/Pages/Counter.razor",
            "GeoBlazorWebApp/Components/Pages/Home.razor"
          ]
        },
        {
          "condition": "(ExcludeLaunchSettings)",
          "exclude": [
            "GeoBlazorWebApp/Properties/launchSettings.json"
          ]
        },
        {
          "condition": "(UseWebAssembly && HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
          "exclude": [
            "*.sln"
          ]
        },
        {
          "condition": "(!IndividualLocalAuth)",
          "exclude": [
            "GeoBlazorWebApp/Components/Account/**",
            "GeoBlazorWebApp/Data/**",
            "GeoBlazorWebApp.Client/UserInfo.cs",
            "GeoBlazorWebApp.Client/Pages/Auth.razor",
            "GeoBlazorWebApp.Client/RedirectToLogin.razor"
          ]
        },
        {
          "condition": "(!(IndividualLocalAuth && !UseLocalDB))",
          "exclude": [
            "GeoBlazorWebApp/Data/app.db"
          ]
        },
        {
          "condition": "(!(IndividualLocalAuth && !UseWebAssembly))",
          "exclude": [
            "GeoBlazorWebApp/Components/Pages/Auth.razor"
          ]
        },
        {
          "condition": "(!(IndividualLocalAuth && UseServer))",
          "exclude": [
            "GeoBlazorWebApp/Components/Account/IdentityRevalidatingAuthenticationStateProvider.cs"
          ]
        },
        {
          "condition": "(IndividualLocalAuth && UseLocalDB && UseWebAssembly)",
          "rename": {
            "GeoBlazorWebApp/Data/SqlServer/": "GeoBlazorWebApp/Data/Migrations/"
          },
          "exclude": [
            "GeoBlazorWebApp/Data/SqlLite/**"
          ]
        },
        {
          "condition": "(IndividualLocalAuth && UseLocalDB && !UseWebAssembly)",
          "rename": {
            "GeoBlazorWebApp/Data/SqlServer/": "Data/Migrations/"
          },
          "exclude": [
            "GeoBlazorWebApp/Data/SqlLite/**"
          ]
        },
        {
          "condition": "(IndividualLocalAuth && !UseLocalDB && UseWebAssembly)",
          "rename": {
            "GeoBlazorWebApp/Data/SqlLite/": "GeoBlazorWebApp/Data/Migrations/"
          },
          "exclude": [
            "GeoBlazorWebApp/Data/SqlServer/**"
          ]
        },
        {
          "condition": "(IndividualLocalAuth && !UseLocalDB && !UseWebAssembly)",
          "rename": {
            "GeoBlazorWebApp/Data/SqlLite/": "Data/Migrations/"
          },
          "exclude": [
            "GeoBlazorWebApp/Data/SqlServer/**"
          ]
        },
        {
          "condition": "(IndividualLocalAuth && UseWebAssembly)",
          "rename": {
            "GeoBlazorWebApp/Components/Account/Shared/RedirectToLogin.razor": "GeoBlazorWebApp.Client/RedirectToLogin.razor"
          }
        }
      ]
    }
  ],
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net8.0"
        },
        {
          "choice": "net9.0"
        },
        {
          "choice": "net10.0"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "DOTNET_TFM"
    },
    "HostIdentifier": {
      "type": "bind",
      "binding": "HostIdentifier"
    },
    "UserSecretsId": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "aspnet-GeoBlazorWebApp-68FF10DE-9D37-4437-A332-022203F995A9",
      "defaultValue": "aspnet-GeoBlazorWebApp-68FF10DE-9D37-4437-A332-022203F995A9",
      "description": "The ID to use for secrets (use with Individual auth)."
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    },
    "ExcludeLaunchSettings": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Whether to exclude launchSettings.json from the generated template."
    },
    "kestrelHttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTP endpoint in launchSettings.json."
    },
    "kestrelHttpPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 5000,
        "high": 5300
      }
    },
    "kestrelHttpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "kestrelHttpPort",
        "fallbackVariableName": "kestrelHttpPortGenerated"
      },
      "replaces": "5500"
    },
    "kestrelHttpsPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTPS endpoint in launchSettings.json. This option is only applicable when the parameter no-https is not used (no-https will be ignored if Individual auth is used)."
    },
    "kestrelHttpsPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 7000,
        "high": 7300
      }
    },
    "kestrelHttpsPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "kestrelHttpsPort",
        "fallbackVariableName": "kestrelHttpsPortGenerated"
      },
      "replaces": "5501"
    },
    "iisHttpPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the IIS Express HTTP endpoint in launchSettings.json."
    },
    "iisHttpPortGenerated": {
      "type": "generated",
      "generator": "port"
    },
    "iisHttpPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "iisHttpPort",
        "fallbackVariableName": "iisHttpPortGenerated"
      },
      "replaces": "8080"
    },
    "iisHttpsPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the IIS Express HTTPS endpoint in launchSettings.json. This option is only applicable when the parameter no-https is not used (no-https will be ignored if Individual auth is used)."
    },
    "iisHttpsPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 44300,
        "high": 44399
      }
    },
    "iisHttpsPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "iisHttpsPort",
        "fallbackVariableName": "iisHttpsPortGenerated"
      },
      "replaces": "44300"
    },
    "InteractivityPlatform": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Server",
      "displayName": "_Interactive render mode",
      "description": "Chooses which interactive render mode to use for interactive components",
      "choices": [
        {
          "choice": "Server",
          "displayName": "Server",
          "description": "Runs on the server"
        },
        {
          "choice": "WebAssembly",
          "displayName": "WebAssembly",
          "description": "Runs in the browser using WebAssembly"
        },
        {
          "choice": "Auto",
          "displayName": "Auto (Server and WebAssembly)",
          "description": "Uses Server while downloading WebAssembly assets, then uses WebAssembly"
        }
      ]
    },
    "InteractivityLocation": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "InteractivePerPage",
      "displayName": "_Interactivity location",
      "description": "Chooses which components will have interactive rendering enabled",
      "isEnabled": "(InteractivityPlatform != \"None\")",
      "choices": [
        {
          "choice": "InteractivePerPage",
          "displayName": "Per page/component",
          "description": "Interactivity is applied on a per-page or per-component basis"
        },
        {
          "choice": "InteractiveGlobal",
          "displayName": "Global",
          "description": "Interactivity is applied at the root level"
        }
      ]
    },
    "UseWebAssembly": {
      "type": "computed",
      "value": "(InteractivityPlatform == \"WebAssembly\" || InteractivityPlatform == \"Auto\")"
    },
    "UseServer": {
      "type": "computed",
      "value": "(InteractivityPlatform == \"Server\" || InteractivityPlatform == \"Auto\")"
    },
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "None",
          "description": "No authentication"
        },
        {
          "choice": "Individual",
          "description": "Individual authentication"
        }
      ],
      "defaultValue": "None",
      "description": "The type of authentication to use"
    },
    "UseLocalDB": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Whether to use LocalDB instead of SQLite. This option only applies if --auth Individual is specified."
    },
    "AllInteractive": {
      "type": "parameter",
      "datatype": "bool",
      "isEnabled": "(InteractivityPlatform != \"None\")",
      "defaultValue": "false",
      "displayName": "_Enable interactive rendering globally throughout the site",
      "description": "Configures whether to make every page interactive by applying an interactive render mode at the top level. If false, pages will use static server rendering by default, and can be marked interactive on a per-page or per-component basis."
    },
    "InteractiveAtRoot": {
      "type": "computed",
      "value": "(InteractivityLocation == \"InteractiveGlobal\" || AllInteractive)"
    },
    "IndividualLocalAuth": {
      "type": "computed",
      "value": "(auth == \"Individual\")"
    },
    "RequiresHttps": {
      "type": "computed",
      "value": "(OrganizationalAuth || IndividualLocalAuth)"
    },
    "HasHttpProfile": {
      "type": "computed",
      "value": "(!RequiresHttps)"
    },
    "HasHttpsProfile": {
      "type": "computed",
      "value": "(RequiresHttps || !NoHttps)"
    },
    "NoHttps": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Whether to turn off HTTPS. This option only applies if Individual isn't used for --auth."
    },
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "copyrightYear",
      "parameters": {
        "format": "yyyy"
      }
    },
    "UseProgramMain": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Do not use _top-level statements",
      "description": "Whether to generate an explicit Program class and Main method instead of top-level statements."
    },
    "UsePro": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Use _Pro version of GeoBlazor",
      "description": "Configures whether to include GeoBlazor Pro features. Default value is false."
    },
    "LightOrDark": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "Light",
          "description": "Light theme"
        },
        {
          "choice": "Dark",
          "description": "Dark theme"
        }
      ],
      "defaultValue": "Light",
      "displayName": "ArcGIS _Theme",
      "description": "The theme to use for importing styles for ArcGIS maps."
    },
    "UseDarkTheme": {
      "type": "computed",
      "value": "(LightOrDark == \"Dark\")"
    },
    "WebAssemblyServer": {
      "type": "generated",
      "generator": "switch",
      "replaces": "${WebAssemblyServerVersion}",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(Framework == \"net8.0\")",
            "value": "8.0.25"
          },
          {
            "condition": "(Framework == \"net9.0\")",
            "value": "9.0.14"
          },
          {
            "condition": "(Framework == \"net10.0\")",
            "value": "10.0.5"
          }
        ]
      }
    },
    "ComponentsWebAssembly": {
      "type": "generated",
      "generator": "switch",
      "replaces": "${ComponentsWebAssemblyVersion}",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(Framework == \"net8.0\")",
            "value": "8.0.25"
          },
          {
            "condition": "(Framework == \"net9.0\")",
            "value": "9.0.14"
          },
          {
            "condition": "(Framework == \"net10.0\")",
            "value": "10.0.5"
          }
        ]
      }
    },
    "DiagnosticsEntityFrameworkCore": {
      "type": "generated",
      "generator": "switch",
      "replaces": "${DiagnosticsEntityFrameworkCoreVersion}",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(Framework == \"net8.0\")",
            "value": "8.0.25"
          },
          {
            "condition": "(Framework == \"net9.0\")",
            "value": "9.0.14"
          },
          {
            "condition": "(Framework == \"net10.0\")",
            "value": "10.0.5"
          }
        ]
      }
    },
    "IdentityEntityFrameworkCore": {
      "type": "generated",
      "generator": "switch",
      "replaces": "${IdentityEntityFrameworkCoreVersion}",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(Framework == \"net8.0\")",
            "value": "8.0.25"
          },
          {
            "condition": "(Framework == \"net9.0\")",
            "value": "9.0.14"
          },
          {
            "condition": "(Framework == \"net10.0\")",
            "value": "10.0.5"
          }
        ]
      }
    },
    "EntityFrameworkCoreTools": {
      "type": "generated",
      "generator": "switch",
      "replaces": "${EntityFrameworkCoreToolsVersion}",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(Framework == \"net8.0\")",
            "value": "8.0.25"
          },
          {
            "condition": "(Framework == \"net9.0\")",
            "value": "9.0.14"
          },
          {
            "condition": "(Framework == \"net10.0\")",
            "value": "10.0.5"
          }
        ]
      }
    },
    "EntityFrameworkCoreSqlServer": {
      "type": "generated",
      "generator": "switch",
      "replaces": "${EntityFrameworkCoreSqlServerVersion}",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(Framework == \"net8.0\")",
            "value": "8.0.25"
          },
          {
            "condition": "(Framework == \"net9.0\")",
            "value": "9.0.14"
          },
          {
            "condition": "(Framework == \"net10.0\")",
            "value": "10.0.5"
          }
        ]
      }
    },
    "WebAssemblyAuthentication": {
      "type": "generated",
      "generator": "switch",
      "replaces": "${WebAssemblyAuthenticationVersion}",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(Framework == \"net8.0\")",
            "value": "8.0.25"
          },
          {
            "condition": "(Framework == \"net9.0\")",
            "value": "9.0.14"
          },
          {
            "condition": "(Framework == \"net10.0\")",
            "value": "10.0.5"
          }
        ]
      }
    },
    "HasAssetMap": {
      "type": "computed",
      "value": "(Framework != \"net8.0\")"
    }
  },
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "postActions": [
    {
      "id": "restore",
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
