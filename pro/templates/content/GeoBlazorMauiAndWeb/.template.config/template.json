{
  "$schema": "http://json.schemastore.org/template",
  "author": "dymaptic",
  "classifications": [
    "MAUI",
    "Android",
    "iOS",
    "macOS",
    "Mac Catalyst",
    "Windows",
    "Blazor",
    "Blazor Hybrid",
    "Mobile",
    "Mapping",
    "Location",
    "Geographic",
